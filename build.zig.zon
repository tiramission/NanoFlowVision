.{
    .name = .nanoflowvision,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // nanoui v0.9.2's src/, with the fixes in third_party/nanoui/PATCHES.md:
        // the GPU renderers had no branch for `ui.texture` (every picture here),
