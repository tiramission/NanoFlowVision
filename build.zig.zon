        .zigimg = .{
            .url = "git+https://github.com/zigimg/zigimg.git#083d0304840a3f5fd547c2e2005148a18886c401",
            .hash = "zigimg-0.1.0-8_eo2j1pGAA3ArMKhXcipNR-tdjmeWmByLJhOff2A_X4",
        },
        .nfd = .{
            .url = "https://github.com/fabioarnold/nfd-zig/archive/refs/heads/master.tar.gz",
            .hash = "nfd-0.1.0-y82kbjyOBgBoCjHiYoe_zCRInYH7UAWOmXrMiQaORnEp",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src" },
    .fingerprint = 0x3ec71862a5fbefd2,
}
